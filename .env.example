# ============================================================
# 模型路由配置
# ============================================================

# [对话 Agent] MiMo v2.5 Pro — 快速交互 + 工具调用
LLM_API_KEY=your_mimo_key
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 直连 MiMo（仅当 LLM_BASE_URL 为 xiaomimimo 且 Key 支持该 id）:
#   LLM_MODEL=mimo-v2.5
# 经 LiteLLM 代理（推荐，与 configs/litellm_config.yaml 一致）:
#   USE_LITELLM_PROXY=true
#   LLM_BASE_URL=http://127.0.0.1:4000/v1
#   LLM_MODEL=mimo-chat
#   LITELLM_FALLBACK_MODEL=deepseek-chat
LLM_MODEL=mimo-chat

# [自主任务 Agent] DeepSeek V4 Pro — 深度规划/分析/决策
AUTONOMOUS_API_KEY=your_deepseek_key
AUTONOMOUS_BASE_URL=https://api.deepseek.com/v1
AUTONOMOUS_MODEL=deepseek-v4-pro

# [批量/高频任务] DeepSeek V4 Flash — 性价比之王
BUDGET_API_KEY=your_deepseek_key
BUDGET_BASE_URL=https://api.deepseek.com/v1
BUDGET_MODEL=deepseek-v4-flash

# [RAG 向量嵌入] OpenAI text-embedding-3-small
# 注意：需要 OpenAI API Key，DeepSeek API 不支持此模型
# 如无 OpenAI Key，设 RAG_USE_EMBEDDINGS=false 使用纯关键词检索
EMBEDDING_API_KEY=your_openai_key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
RAG_USE_EMBEDDINGS=true

# ============================================================
# 兼容旧变量名
# ============================================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ============================================================
# Gitee Wiki（知识库 + 边界对抗集同步）
# ============================================================
# 有 Token 时从 Gitee Wiki 拉取；无 Token 时用 data/wiki_export + 种子知识
GITEE_API_TOKEN=
GITEE_WIKI_OWNER=swok
GITEE_WIKI_REPO=security-agent

# Cursor 密钥（crsr_ 开头，仅 IDE 扩展用，不能替代 LLM 对话）
CURSOR_API_KEY=

# ============================================================
# 功能开关
# ============================================================

# P2 监控：登录审计 / 端口 / cron
MONITOR_AUTH_ENABLED=true
MONITOR_LISTEN_ENABLED=true
MONITOR_CRON_ENABLED=true
AUTH_FAIL_BURST_THRESHOLD=5

# 离屏告警：严重/高 事件写入 data/alerts/，并尝试桌面 notify-send
NOTIFY_DESKTOP=true

# ============================================================
# 🔀 LiteLLM Proxy（推荐用于演示/生产）
# ============================================================
# LiteLLM 是一个智能代理层，位于应用和模型 API 之间：
#
#   直接连接: 你的提问 → MiMo API
#   LiteLLM: 你的提问 → LiteLLM代理 → MiMo API
#                                      ↓ (失败时自动切换)
#                                    DeepSeek API
#
# 优势：自动失败回退、统一成本追踪、集中日志管理
#
# 快速启用：
#   1. pip install 'litellm[proxy]'
#   2. bash scripts/litellm_manager.sh start
#   3. bash scripts/litellm_manager.sh enable
#   4. bash boot_stop.sh && bash boot_start.sh
#
# 详细文档: docs/LITELLM_GUIDE.md

# 是否启用 LiteLLM 代理（true 时 LLM_MODEL 须为 mimo-chat，备用为 deepseek-chat）
USE_LITELLM_PROXY=false

# 代理地址
LITELLM_PROXY_URL=http://127.0.0.1:4000/v1

# 主控 Key（用于代理认证，可自定义）
LITELLM_MASTER_KEY=sk-1234

# 主模型失败时的 LiteLLM 备用别名（勿填 deepseek-v4-flash）
LITELLM_FALLBACK_MODEL=deepseek-chat

# ============================================================
# 启动命令
# ============================================================
# 认证（JWT 密钥持久化在 data/.jwt_secret，重启后端不会全员掉线）
# JWT_SECRET=your-long-random-secret
# JWT_EXPIRE_HOURS=24

# ============================================================
# 普通启动:  bash boot_start.sh
# 停止应用:  bash boot_stop.sh
# 带代理启动: bash scripts/litellm_manager.sh start && bash boot_start.sh
# 终端监控:  uv run python scripts/alert_watch.py