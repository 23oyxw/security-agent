{
  "version": "1.1",
  "description": "MCP workflow manifest: HTN + tier labels + sandbox flags",
  "tier_labels": {
    "T0": "定义封装",
    "T1": "五层流水线",
    "T2": "数学量化",
    "T3": "工作流标注",
    "T4": "沙箱全包"
  },
  "workflows": [
    {
      "id": "wf_parallel_info",
      "title": "并行信息采集",
      "tier": "T3",
      "intent": "parallel_info",
      "tool_chain": [
        "query_security_scan_json",
        "list_processes",
        "get_system_health",
        "check_exposed_ports"
      ],
      "htn_steps": [
        {"task": "scan_metrics", "cluster": "metrics"},
        {"task": "process_inventory", "cluster": "metrics"},
        {"task": "health_snapshot", "cluster": "metrics"}
      ],
      "cost_budget": 0,
      "layer": "L3",
      "sandbox_required": false,
      "math_model": null
    },
    {
      "id": "wf_health_audit",
      "title": "健康与审计",
      "tier": "T3",
      "intent": "health",
      "tool_chain": ["get_system_health", "get_audit_log"],
      "htn_steps": [
        {"task": "health_metrics", "cluster": "metrics"},
        {"task": "audit_logs", "cluster": "logs"}
      ],
      "cost_budget": 0,
      "layer": "L3",
      "sandbox_required": false,
      "math_model": "htn_0_1"
    },
    {
      "id": "wf_full_check",
      "title": "全量安全体检",
      "tier": "T3",
      "intent": "full_check",
      "tool_chain": ["run_full_security_check"],
      "htn_steps": [
        {"task": "baseline_metrics", "cluster": "metrics"},
        {"task": "remediate", "cluster": "repair"}
      ],
      "cost_budget": 1,
      "layer": "L3",
      "sandbox_required": true,
      "math_model": "htn_0_1"
    },
    {
      "id": "wf_autonomous",
      "title": "自主运维调度",
      "tier": "T3",
      "intent": "autonomous",
      "tool_chain": ["run_autonomous_mission"],
      "htn_steps": [
        {"task": "plan", "cluster": "dispatch"},
        {"task": "execute_mission", "cluster": "dispatch"}
      ],
      "cost_budget": 1,
      "layer": "L3",
      "sandbox_required": true,
      "math_model": "htn_0_1"
    },
    {
      "id": "wf_scan_report",
      "title": "扫描报告 Skill Flow",
      "tier": "T3",
      "intent": "scan_report",
      "skill_flow": "scan_report",
      "htn_steps": [
        {"task": "l2_flow_scan", "cluster": "metrics"},
        {"task": "report_logs", "cluster": "logs"}
      ],
      "cost_budget": 1,
      "layer": "L2-L3",
      "sandbox_required": true,
      "math_model": "htn_0_1"
    }
  ]
}
