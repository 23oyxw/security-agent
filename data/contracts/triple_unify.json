{
  "version": "1.0",
  "updated": "2026-06-11",
  "formula": "1调度 + 1安全 + 1迭代",
  "main_line": [
    "L1",
    "L2",
    "GATE",
    "L3",
    "L4",
    "L5"
  ],
  "auxiliary": [
    "trace",
    "tools",
    "knowledge",
    "alerts"
  ],
  "orchestrator": {
    "id": "orchestrator",
    "display_name": "编排助手",
    "description": "前端双模式：计划(L1 analyze) / 执行(L3 execute)，串联三代 Agent",
    "modes": [
      "plan",
      "execute"
    ]
  },
  "agents": [
    {
      "agent": "core_dispatch",
      "display_name": "核心调度代理",
      "layer": "L1+L3",
      "layer_note": "阶段锁 analyze->execute",
      "description": "L1 三感知：抗性边界·灵敏知识·静态之眼 | L3 推理·MCP",
      "phases": [
        "analyze",
        "execute"
      ],
      "spine_role": "main",
      "can_write_in_phase": {
        "execute": true
      }
    },
    {
      "agent": "safety_sandbox",
      "display_name": "安全防护沙箱代理",
      "layer": "L2",
      "layer_note": "唯一安全闸门",
      "description": "护栏·熔断·沙箱预演·高危截断·二次确认",
      "phases": [
        "precheck"
      ],
      "spine_role": "main"
    },
    {
      "agent": "audit_iteration",
      "display_name": "审计迭代代理",
      "layer": "L4+L5",
      "layer_note": "溯源·回流·量化",
      "description": "trace 卷宗·链路绘图·Wiki 回流·六维指标自进化",
      "phases": [
        "finalize"
      ],
      "spine_role": "auxiliary"
    }
  ],
  "layer_agent_map": {
    "L1": "core_dispatch",
    "L2": "safety_sandbox",
    "GATE": "core_dispatch",
    "L3": "core_dispatch",
    "L4": "audit_iteration",
    "L5": "audit_iteration"
  },
  "pipeline_stages": [
    "L1_triple_perception",
    "L1_intent",
    "L2_safety_sandbox",
    "GATE_layer_pass",
    "L3_execute_start",
    "L4_audit_finalize",
    "L5_analytics_snapshot"
  ],
  "tool_clusters": [
    {
      "cluster": "metrics",
      "display_name": "指标采集",
      "examples": [
        "get_system_health",
        "query_security_scan_json"
      ]
    },
    {
      "cluster": "logs",
      "display_name": "日志处理",
      "examples": [
        "get_audit_log",
        "journal"
      ]
    },
    {
      "cluster": "repair",
      "display_name": "故障修复",
      "examples": [
        "run_terminal_command",
        "run_full_security_check"
      ]
    },
    {
      "cluster": "dispatch",
      "display_name": "资源调度",
      "examples": [
        "run_autonomous_mission",
        "cpu_stress"
      ]
    }
  ],
  "stage_spine_map": {
    "L1_triple_perception": [
      "spine-l1-input",
